DEPLOYMENT=prod
DATABASE_URL=file:../data/dev.db
APP_DOMAIN=accounts.jointheleague.org
APP_NAME="Student Accounts"
APP_SLUG=student-accounts

# OAuth callback URLs (non-secret, environment-specific)
GITHUB_CALLBACK_URL=https://accounts.jointheleague.org/api/auth/github/callback
GOOGLE_CALLBACK_URL=https://accounts.jointheleague.org/api/auth/google/callback
PIKE13_CALLBACK_URL=https://accounts.jointheleague.org/api/auth/pike13/callback
PIKE13_API_BASE=https://jtl.pike13.com/api/v2/desk

# DigitalOcean Spaces endpoint and bucket (not secret)
DO_SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
DO_SPACES_BUCKET=league-student-storage
DO_SPACES_REGION=sfo3
# Laptop roster bucket (students/<id>/config.json, written by the League
# laptops' league-helper and by this app). Read with the same DO_SPACES_KEY /
# DO_SPACES_SECRET as backups; it is a second bucket, not a second key.
# Default when unset: jtl-student-unix-accounts
LAPTOP_ROSTER_BUCKET=jtl-student-unix-accounts

ADMIN_EMAILS=eric.busboom@jointheleague.org              # your staff email so you get role=admin
GOOGLE_WORKSPACE_WRITE_ENABLED=1                 # opt-in to live writes
GOOGLE_STUDENT_DOMAIN=students.jointheleague.org
GOOGLE_STUDENT_OU_ROOT=/Students                 # or whatever the actual path is
GOOGLE_ADMIN_DELEGATED_USER_EMAIL=provisionbot@jointheleague.org
GOOGLE_STAFF_OU_PATH=/Staff              # or your actual staff OU

EMAIL_FROM_ADDRESS='no-reply@jointheleague.org'
EMAIL_FROM_NAME='League Student Accounts'
SMTP_HOST=email-smtp.us-west-2.amazonaws.com
SMTP_PORT=587

# --- LLM Proxy: Anthropic-compatible endpoint (Claude Code) ---
# Both keys are also editable on the admin Config page (no restart needed);
# an env value here overrides the database value.
#
# LLM_PROXY_ANTHROPIC_ENABLED: serve POST /proxy/v1/messages (Anthropic Messages
#   protocol, passed through to OpenRouter) so Claude Code works with
#   ANTHROPIC_BASE_URL=https://student-accounts.jtlapp.net/proxy and
#   ANTHROPIC_AUTH_TOKEN=llmp_... Default true. Set to false if OpenRouter's
#   Anthropic endpoint misbehaves: the route returns 404 and the student/admin
#   pages hide the Claude Code setup.
# LLM_PROXY_ANTHROPIC_ENABLED=true
#
# LLM_PROXY_ANTHROPIC_BASE_URL: OpenRouter's Anthropic-compatible Messages URL.
# LLM_PROXY_ANTHROPIC_BASE_URL=https://openrouter.ai/api/v1/messages
